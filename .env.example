# Development: explicit local storage, no AWS calls. Copy this file to .env.
APP_ENV=development
STORAGE_MODE=local
PORT=5000
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
OMDB_API_KEY=
ENABLE_DEMO_LOGIN=true
CORS_ORIGINS=http://localhost:3000

# Deployment: APP_ENV=production, STORAGE_MODE=aws, ENABLE_DEMO_LOGIN=false.
# Use an EC2 instance role or AWS_PROFILE locally; never commit access keys.
AWS_REGION=ap-southeast-2
# For manual tables use their exact names. CloudFormation dev outputs are below.
DYNAMODB_USERS_TABLE=MovieRecom_Users_dev
DYNAMODB_WATCHLIST_TABLE=MovieRecom_Watchlists_dev
DYNAMODB_RATINGS_TABLE=MovieRecom_Ratings_dev
S3_AVATAR_BUCKET=
# Use the actual bucket name from the stack outputs, not an example name.
# Cognito is not used by this application. Authentication uses Flask JWT.

# Optional LocalStack endpoints for AWS integration development:
# DYNAMODB_ENDPOINT_URL=http://localhost:4566
# S3_ENDPOINT_URL=http://localhost:4566
