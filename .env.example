# ==========================================
# MOVIE RECOMMENDER SYSTEM CONFIGURATION
# ==========================================

# OMDb API Configuration
OMDB_API_KEY=7acedfb7
REACT_APP_OMDB_API_KEY=7acedfb7

# Flask Server Port
PORT=5000
JWT_SECRET=super-secret-movierecom-jwt-key-change-in-production

# ==========================================
# AWS CLOUD SERVICES CONFIGURATION
# ==========================================
# Leave empty to run in Local Emulation Mode (SQLite/Local S3 store).
# Once filled with valid AWS credentials, the app automatically switches to live AWS Cloud!

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon DynamoDB Tables (defaults shown)
DYNAMODB_USERS_TABLE=MovieRecom_Users
DYNAMODB_WATCHLIST_TABLE=MovieRecom_Watchlists
DYNAMODB_RATINGS_TABLE=MovieRecom_Ratings

# Amazon S3 Bucket for User Avatars
S3_AVATAR_BUCKET=movierecom-user-avatars

# Amazon Cognito Authentication (Optional)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# LocalStack Configuration (Optional, if using localstack docker)
# DYNAMODB_ENDPOINT_URL=http://localhost:4566
# S3_ENDPOINT_URL=http://localhost:4566
